// academico-service/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

enum CategoriaPublicacao {
  ARTIGO
  TCC
  DISSERTACAO
  TESE
  RELATORIO_TECNICO
}

enum StatusPublicacao {
  PENDENTE  // Aguarda avaliação do orientador
  APROVADA
  REJEITADA
}

enum TipoProjeto {
  PESQUISA
  EXTENSAO
}

model Publicacao {
  id              String              @id @default(uuid())
  titulo          String              
  resumo          String              
  categoria       CategoriaPublicacao
  arquivoUrl      String?             // Aqui ficará o caminho do PDF guardado pelo Multer
  
  autorPrincipalId String             
  orientadorId     String?            // <-- NOVO: ID do Professor (Opcional, pois artigos podem não ter)

  // Publicações com orientador nascem PENDENTE; sem orientador já entram APROVADA
  status          StatusPublicacao    @default(APROVADA)
  parecer         String?             // Comentário do orientador (obrigatório ao rejeitar)
  avaliadoEm      DateTime?

  dataPublicacao  DateTime
  criadoEm        DateTime            @default(now())

  @@index([autorPrincipalId])
  @@index([orientadorId]) // <-- NOVO: Índice para buscas pelo orientador
  @@map("publicacoes")
}

model Projeto {
  id              String      @id @default(uuid())
  titulo          String      
  descricao       String      
  tipo            TipoProjeto
  status          String      @default("EM_ANDAMENTO") // EM_ANDAMENTO, CONCLUIDO
  
  // "Soft Reference" para o perfil-service
  coordenadorId   String      
  
  dataInicio      DateTime
  dataFim         DateTime?
  
  criadoEm        DateTime    @default(now())
  atualizadoEm    DateTime    @updatedAt

  @@index([coordenadorId])
  @@map("projetos")
}

// ---------- Comunidade (feed social de divulgações) ----------

enum CategoriaPostagem {
  GERAL
  EVENTO
  OPORTUNIDADE
  DUVIDA
  CONQUISTA
}

model Postagem {
  id          String            @id @default(uuid())
  autorId     String            // "Soft Reference" para o perfil-service
  conteudo    String
  categoria   CategoriaPostagem @default(GERAL)
  imagemUrl   String?           // Caminho da imagem guardada pelo Multer

  curtidas    Curtida[]
  comentarios Comentario[]

  criadoEm    DateTime          @default(now())

  @@index([criadoEm])
  @@map("postagens")
}

model Curtida {
  postagemId String
  usuarioId  String
  postagem   Postagem @relation(fields: [postagemId], references: [id], onDelete: Cascade)
  criadoEm   DateTime @default(now())

  @@id([postagemId, usuarioId]) // Cada utilizador só curte uma vez
  @@map("curtidas")
}

model Comentario {
  id         String   @id @default(uuid())
  postagemId String
  autorId    String
  conteudo   String
  postagem   Postagem @relation(fields: [postagemId], references: [id], onDelete: Cascade)
  criadoEm   DateTime @default(now())

  @@index([postagemId])
  @@map("comentarios")
}


// ---------- Notificações ----------

enum TipoNotificacao {
  NOVA_POSTAGEM         // Para todos: alguém publicou na comunidade
  NOVA_PUBLICACAO       // Para todos: um trabalho ficou público
  SUBMISSAO_RECEBIDA    // Para o orientador: há um trabalho para avaliar
  PUBLICACAO_APROVADA   // Para o autor
  PUBLICACAO_REJEITADA  // Para o autor, com o parecer
}

model Notificacao {
  id             String          @id @default(uuid())
  tipo           TipoNotificacao
  destinatarioId String?         // Nulo = para todos os usuários
  ocultarPara    String[]        // Em avisos para todos: quem não deve receber (ex: o próprio autor)
  atorId         String          // Quem causou o evento ("Soft Reference" para o perfil-service)
  referenciaId   String          // Id da postagem ou publicação
  resumo         String          // Título do trabalho ou trecho da postagem
  detalhe        String?         // Parecer do orientador

  leituras       NotificacaoLeitura[]

  criadoEm       DateTime        @default(now())

  @@index([destinatarioId, criadoEm])
  @@index([referenciaId])
  @@map("notificacoes")
}

model NotificacaoLeitura {
  notificacaoId String
  usuarioId     String
  notificacao   Notificacao @relation(fields: [notificacaoId], references: [id], onDelete: Cascade)
  lidaEm        DateTime    @default(now())

  @@id([notificacaoId, usuarioId])
  @@map("notificacoes_leituras")
}
