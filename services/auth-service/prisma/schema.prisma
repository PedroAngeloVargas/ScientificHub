// auth-service/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Credencial {
  id        String   @id @default(uuid())
  email     String   @unique
  senha     String   
  perfilId  String   @unique 
  criadoEm  DateTime @default(now())

  @@map("credenciais")
}