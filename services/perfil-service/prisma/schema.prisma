// perfil-service/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

enum TipoUsuario {
  ALUNO
  PROFESSOR
  PESQUISADOR_EXTERNO
  ADMIN
}

model Disciplina {
  id   String @id @default(uuid())
  nome String @unique

  @@map("disciplinas")
}

model Usuario {
  id           String      @id @default(uuid())
  nome         String
  email        String      @unique
  cpf          String      @unique // Novo campo obrigatório no cadastro
  telefone     String?             // Preenchido no primeiro acesso
  endereco     String?             // Preenchido no primeiro acesso
  matricula    String      @unique
  tipo         TipoUsuario
  curso        String
  departamento String

  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt

  @@map("usuarios")
}